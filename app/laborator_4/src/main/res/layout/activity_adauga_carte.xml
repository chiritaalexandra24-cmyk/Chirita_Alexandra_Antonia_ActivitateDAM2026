<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AdaugaCarte">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. TextView -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formular Adăugare Carte"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 2. EditText -->
        <EditText
            android:id="@+id/etTitlu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduceți titlul cărții"
            android:inputType="text" />

        <!-- 3. Spinner (Meniu derulant pentru categorie, de exemplu) -->
        <Spinner
            android:id="@+id/spinnerCategorie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- 4. RadioButton (grupate într-un RadioGroup) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Format carte:" />
        <RadioGroup
            android:id="@+id/rgFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbFizic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fizic"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbDigital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Digital (E-book)" />
        </RadioGroup>

        <!-- 5. CheckBox -->
        <CheckBox
            android:id="@+id/cbIlustratii"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conține ilustrații"
            android:layout_marginTop="8dp"/>

        <!-- 6. Switch -->
        <Switch
            android:id="@+id/switchDisponibilitate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponibilă în stoc: "
            android:layout_marginTop="8dp"/>

        <!-- 7. RatingBar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota (Rating):"
            android:layout_marginTop="16dp"/>
        <RatingBar
            android:id="@+id/ratingBarNota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0" />

        <!-- 8. Button -->
        <Button
            android:id="@+id/btnSalveazaCarte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvează și trimite"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>