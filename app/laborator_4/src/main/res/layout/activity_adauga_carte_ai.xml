<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Formular AI 🤖"
            android:textAlignment="center"
            android:textColor="#6200EE"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitluAI"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:hint=" Titlul cărții..."
            android:paddingStart="12dp" />

        <Switch
            android:id="@+id/switchDisponibilAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Este disponibilă în stoc?"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSalveazaAI"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#6200EE"
            android:text="SALVEAZĂ CARTEA (AI)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>